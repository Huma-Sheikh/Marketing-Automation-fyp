# Business scraper + sentiment service (port 8003) - every env var read by app/config.py.

# Directory holding sentiment_roberta/ and business_category/ checkpoints.
MODELS_DIR=model
# Google Places API key. Empty = /search and /find-opportunities return demo businesses.
GOOGLE_PLACES_API_KEY=
# Minimum classifier confidence before its category is used (otherwise "Professional Services").
CATEGORY_MIN_CONFIDENCE=0.75
