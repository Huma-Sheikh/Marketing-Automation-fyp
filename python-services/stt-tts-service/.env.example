# STT/TTS service (port 8001) - every env var read by app/config.py.
# Model paths are fixed: models/stt_model_final, models/tts_model_final/<lang>, models/tts_model_base/<lang>.

# Languages that serve their fine-tuned voice instead of the base MMS voice: comma list (e.g. "en,de") or "all". Empty = base voices.
TTS_FINETUNED_LANGS=
# Optional path to a perl uroman checkout; only used if the `uroman` pip package is not installed. Unset by default.
# UROMAN=/opt/uroman
