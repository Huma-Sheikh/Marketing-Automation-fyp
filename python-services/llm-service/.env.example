# LLM chat service (port 8004) - every env var read by app/config.py.
# Model path is fixed: models/model-q4_K_M.gguf (stub mode if missing).

# CPU threads llama.cpp uses for inference.
LLM_THREADS=4
# Max sentences in a /chat reply (<= 0 disables the cap).
LLM_MAX_SENTENCES=2
# Upper bound on generated tokens per /chat turn (min'd with the request's max_tokens).
LLM_MAX_CHAT_TOKENS=80
