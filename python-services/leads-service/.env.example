# Leads + NER + scoring service (port 8002) - every env var read by app/config.py.
# Model paths are fixed: model/distilbert_ner_prod_v2 and model/scorer/xgboost_scorer.joblib.

# "demo" (default) returns labelled demo leads and never touches third-party sites; "live" enables real scraping.
SCRAPE_MODE=demo
# Per-request HTTP timeout in seconds for the live scrapers.
SCRAPE_TIMEOUT=12
