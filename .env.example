# Variables docker-compose.yml substitutes itself. Copy to `.env` next to
# docker-compose.yml. Each service's own settings live in its own env file:
#   nestjs-backend/.env           (see nestjs-backend/.env.example)
#   nextjs-frontend/.env.local    (see nextjs-frontend/.env.local.example)
#   python-services/<service>/.env.example documents each Python service.

# Google Places key for business-service (business search / opportunities).
# Empty = the service returns generated sample businesses instead of real ones.
GOOGLE_PLACES_API_KEY=

# Languages that use the fine-tuned TTS voice instead of base MMS, e.g. "en,de"
# or "all". Empty = base voice everywhere. Default in docker-compose: ar,de,en,fr
TTS_FINETUNED_LANGS=ar,de,en,fr
