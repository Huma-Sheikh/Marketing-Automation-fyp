PORT=3001
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
# NeonDB connection string — get from https://console.neon.tech → your project → Connection Details
DATABASE_URL=postgresql://username:password@hostname.neon.tech/dbname?sslmode=require

# ── Redis (Bull queues) ──────────────────────────────────────────────────────
# Use `localhost` when running the backend directly with `npm run start:dev`.
# docker-compose overrides this to `redis`; do not rely on this value in Docker.
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Auth ─────────────────────────────────────────────────────────────────────
# Required, minimum 32 characters — the app refuses to boot without it.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── Python AI services ───────────────────────────────────────────────────────
# Again, these are the values for running everything on the host.
# docker-compose overrides them with the compose service names.
STT_SERVICE_URL=http://localhost:8001
TTS_SERVICE_URL=http://localhost:8001
LEADS_SERVICE_URL=http://localhost:8002
BUSINESS_SERVICE_URL=http://localhost:8003
LLM_SERVICE_URL=http://localhost:8004

# ── Twilio (voice + SMS) ─────────────────────────────────────────────────────
# The platform's own number: used when a tenant has not attached one of theirs.
# Leave as-is to run without it: the backend detects the placeholder SID and
# only tenant-attached numbers (Settings → Phone Numbers) can dial.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ── Tenant phone numbers ──────────────────────────────────────────────────────
# Encrypts the Twilio/Vapi credentials tenants attach under Settings → Phone
# Numbers (AES-256-GCM). Falls back to JWT_SECRET when empty, but set it in
# production: rotating JWT_SECRET would otherwise make every stored credential
# unreadable. Generate the same way as JWT_SECRET.
CREDENTIALS_ENCRYPTION_KEY=

# ── Email ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@yourdomain.com

# ── Billing ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_STARTER=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_AGENCY=price_xxxxxxxxxxxxxxxxxxxx

# ── Business search ──────────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── URLs ─────────────────────────────────────────────────────────────────────
# BASE_URL must be PUBLICLY reachable by Twilio — it is used for the TwiML
# webhook and for the wss:// media-stream URL. In development use an ngrok or
# Cloudflare tunnel host, e.g. https://your-id.ngrok-free.app
BASE_URL=https://yourdomain.com
FRONTEND_URL=http://localhost:3000
# Extra CORS origins, comma-separated. Add http://localhost when serving the app
# through the nginx container on port 80.
ALLOWED_ORIGINS=
