# Copy to .env.local. Every variable is read in src/lib/config.ts; NEXT_PUBLIC_*
# values are inlined into the browser bundle at build time, so rebuild after changing them.

# Base URL of the NestJS API, including the /api prefix.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# How often the dashboard re-polls analytics, in milliseconds (default 10000).
NEXT_PUBLIC_DASHBOARD_REFRESH_MS=10000
